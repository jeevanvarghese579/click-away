<Window x:Class="KeysAutoclicker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Click Away" Width="1120" Height="760" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Accent" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2979FF"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="2"/><Setter Property="Foreground" Value="{DynamicResource Foreground}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Foreground}"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource Foreground}"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Click Away" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/><TextBlock Text="Keyboard shortcuts, your way" Foreground="{DynamicResource Muted}" Margin="0,3,0,12"/><ToggleButton x:Name="MasterToggle" Content="Click Away ON / OFF" Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed" FontWeight="SemiBold"/></StackPanel>
   <TextBlock Grid.Row="2" Text="PROFILES" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Bold"/>
   <ListBox Grid.Row="3" x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectionChanged="ProfileList_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="-8,8,-8,8"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4" ToolTip="Select to edit; multiple profiles can be enabled together"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"/><ToggleButton Grid.Column="1" IsChecked="{Binding Enabled}" Checked="ProfileToggle_Changed" Unchecked="ProfileToggle_Changed" Content="ON"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel Grid.Row="4"><Button Content="+  New Profile" Click="NewProfile_Click" Style="{StaticResource Accent}"/><WrapPanel HorizontalAlignment="Center"><Button Content="Duplicate" Click="DuplicateProfile_Click"/><Button Content="↑" Tag="Up" Click="MoveProfile_Click"/><Button Content="↓" Tag="Down" Click="MoveProfile_Click"/><Button Content="Delete" Click="DeleteProfile_Click"/></WrapPanel><Border Background="{DynamicResource InputBackground}" CornerRadius="9" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock Text="PLAYBACK TIMING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="Normal keys" Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"/><TextBox x:Name="KeyDelayInput" Grid.Column="1" ToolTip="Milliseconds between normal key presses"/></Grid><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="Shortcuts" Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"/><TextBox x:Name="ShortcutDelayInput" Grid.Column="1" ToolTip="Milliseconds after shortcut combinations"/></Grid><TextBlock Text="milliseconds" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Border></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="2"/>
  <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="{Binding SelectedProfile.Name}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/><TextBlock Text="Editing this profile only — its ON/OFF state never affects other profiles." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="Dark" Foreground="{DynamicResource Foreground}" VerticalAlignment="Center"/><ToggleButton x:Name="ThemeToggle" Content="Theme" Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" Margin="8,0,0,0"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl x:Name="MacroItems"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/><StackPanel Grid.Column="1" Orientation="Horizontal"><ToggleButton IsChecked="{Binding Enabled}" Content="ON" Checked="MacroToggle_Changed" Unchecked="MacroToggle_Changed"/><Button Content="Duplicate" Click="DuplicateMacro_Click"/><Button Content="Delete" Click="DeleteMacro_Click"/></StackPanel></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="When I press:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Trigger,UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Trigger_PreviewKeyDown" FontWeight="SemiBold" ToolTip="Click here and press a global shortcut, such as F1 or Ctrl+F2"/><Button Grid.Column="2" Content="Record" Click="RecordTrigger_Click" ToolTip="Record any shortcut, including Alt+Tab"/><TextBlock Grid.Column="3" Text="Use Record for Alt+Tab and other Windows shortcuts." Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
    <TextBlock Grid.Row="4" Text="Then do:" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <StackPanel Grid.Row="4" Margin="0,28,0,0"><ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="•" Foreground="#2979FF" FontSize="20" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding EditorValue,UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="Action_PreviewKeyDown" ToolTip="Press a key or combination; for Wait enter milliseconds"/><Button Grid.Column="3" Content="Record" Click="RecordAction_Click" ToolTip="Record a shortcut; this safely captures Alt+Tab"/><TextBox Grid.Column="4" Text="{Binding Repeat,UpdateSourceTrigger=PropertyChanged}" ToolTip="Repeat count for key and shortcut actions"/><StackPanel Grid.Column="5" Orientation="Horizontal"><Button Content="Copy" Click="DuplicateAction_Click"/><Button Content="↑" Tag="Up" Click="MoveAction_Click"/><Button Content="↓" Tag="Down" Click="MoveAction_Click"/><Button Content="×" Click="DeleteAction_Click"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,9,0,0"><Button Content="+ Key / Shortcut" Style="{StaticResource Accent}" Click="AddAction_Click"/><Button Content="+ Wait" Click="AddDelay_Click"/><Button Content="● Record Sequence" Click="RecordSequence_Click" ToolTip="Capture multiple actions; press Esc to finish"/></WrapPanel><TextBlock Text="Use Record Sequence to capture several keys or shortcuts. Press Esc to stop recording." Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,7,0,0"/></StackPanel>
    </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="+  Add Shortcut" Click="AddMacro_Click" Style="{StaticResource Accent}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
   <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"><Run Text="Developed by Jeevan Varghese  •  Visit "/><Hyperlink NavigateUri="https://itsjeevanvarghese.web.app" RequestNavigate="Website_RequestNavigate" TextDecorations="None" Foreground="#2979FF">itsjeevanvarghese.web.app</Hyperlink><Run Text=" for more software."/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="Triggers are global" Foreground="#2979FF" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
